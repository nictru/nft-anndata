<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.nictru</groupId>
  <artifactId>nft-anndata</artifactId>
  <name>nft-anndata</name>
  <version>0.5.0</version>
  <description>nf-test plugin for the AnnData file format</description>
  <url>https://github.com/nictru/nft-anndata</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>http://www.opensource.org/licenses/mit</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/nictru/nft-anndata</connection>
    <developerConnection>scm:git:ssh://github.com:nictru/nft-anndata.git</developerConnection>
    <url>https://github.com/nictru/nft-anndata/tree/main</url>
  </scm>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>add-nf-anndata-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>deps/nf-anndata/src/main/java</source>
                <source>deps/nf-anndata/deps/jhdf/jhdf/src/main/java</source>
                <source>deps/nf-anndata/deps/zarr-java/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>unidata-all</id>
      <name>Unidata All</name>
      <url>https://artifacts.unidata.ucar.edu/repository/unidata-all/</url>
    </repository>
  </repositories>
  <properties>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <aws.version>2.34.6</aws.version>
    <java.version>17</java.version>
    <netcdfJavaVersion>5.9.1</netcdfJavaVersion>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <findbugs.version>3.0.2</findbugs.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <additionalparam>-Xdoclint:none</additionalparam>
    <jackson.version>2.20.0</jackson.version>
    <zstdVersion>1.5.5-7</zstdVersion>
  </properties>
</project>
